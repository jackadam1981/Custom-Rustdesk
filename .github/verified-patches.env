# =============================================================================
# CI 插针 rollout 开关（队列构建读取本文件；patch-lab 验收通过后再改）
# =============================================================================
#
# Q0 已验收固化（2026-06-17）：
#   Run 27700547234 / Release q0-vanilla-20260617-153212
#
# 用法：只改最后一行 CUSTOM_VERIFIED_PATCH_UP_TO 的值。
#   ""     = Q0 零针
#   "R01"  = 连接默认（ID/中继/API/Key/超级密码/锁定/隐藏）
#   "P04"  = 22 针全开
#
# 2026-07 UI 针重编号：F/S 同号 = 同一逻辑控件（logo/名/slogan/powered/about…）
#   旧 S13(配置菜单) → 新 S15；旧 F11(powered) → F13；旧 F12(关于) → F14
#
# 本地：scripts/patch-lab/run.sh --profile baixin --patch-up-to S15
#
# -----------------------------------------------------------------------------
# 序 | ID  | 逻辑控件              | 脚本
# -----------------------------------------------------------------------------
#  1 | R01 | 连接七项              | patches/core/r01.sh
#  2 | R03 | is_custom_client      | patches/core/is-custom-client.sh
#  3 | B01 | 壳层显示名            | patches/brand/brand-files.sh
#  4 | B02 | logo/banner/ico       | patches/brand/logo-assets.sh
#  5 | I01 | cn/en 文案            | patches/i18n/ui-strings.sh
#  6 | F02 | 窗口标题              | patches/flutter/app-name.sh
#  7 | F10 | 首页 logo             | patches/flutter/home-logo.sh
#  8 | F11 | 首页 app 名           | patches/flutter/home-title.sh
#  9 | F12 | 首页 slogan           | patches/flutter/home-slogan.sh
# 10 | F13 | Powered-by            | patches/flutter/powered-by.sh
# 11 | F14 | 关于页工作室          | patches/flutter/about-studio.sh
# 12 | S10 | 首页 logo             | patches/sciter/home-logo.sh
# 13 | S11 | 首页 app 名           | patches/sciter/home-title.sh
# 14 | S12 | 首页 slogan           | patches/sciter/home-slogan.sh
# 15 | S13 | Powered-by            | patches/sciter/powered-by.sh
# 16 | S14 | 关于页工作室          | patches/sciter/about-studio.sh
# 17 | S15 | 设置菜单滚动          | patches/sciter/config-menu-css.sh
# 18 | P01 | 便携工作目录          | patches/platform/portable-workdir.sh
# 19 | P02 | Windows 签名          | patches/platform/windows-signing.sh
# 20 | P03 | MSI noop              | patches/platform/msi-noop.sh
# 21 | P04 | rust-cache 非致命     | patches/platform/rust-cache-nonfatal.sh
# -----------------------------------------------------------------------------

# CUSTOM_VERIFIED_PATCH_UP_TO="R01"
# …

# UI 针重编号后须 patch-lab 全量回归再 bump；暂空 = 等验收
# 旧 "S13"(全 Sciter UI) 等价于新 "S15"
CUSTOM_VERIFIED_PATCH_UP_TO=""
