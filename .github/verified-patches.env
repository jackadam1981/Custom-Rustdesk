# =============================================================================
# CI 插针 rollout 开关（队列构建读取本文件；patch-lab 验收通过后再改）
# =============================================================================
#
# Q0 已验收固化（2026-06-17）：
#   Run 27700547234 / Release q0-vanilla-20260617-153212
#   当前 "" = 零针；下一针 R01（连接/服务器，见 r01.sh）
#
# 用法：只改最后一行 CUSTOM_VERIFIED_PATCH_UP_TO 的值。
#   ""     = Q0 零针
#   "R01"  = 连接默认（ID/中继/API/Key/超级密码/锁定/隐藏，1 脚本改 2 个 .rs）
#   "R03"  = + is_custom_client
#   "P04"  = 16 针全开
#
# 连接七项在 r01.sh 内按变量条件插；api_server 空则不写 api-server；super_password 空则不写 HARD_SETTINGS password；
# lock_network_settings / hide_network_settings 同属 R01（非独立针）。
#
# 本地：scripts/patch-lab/run.sh --profile baixin --patch-up-to R01
#
# -----------------------------------------------------------------------------
# 序 | ID  | 中文说明                              | 脚本
# -----------------------------------------------------------------------------
#  0 | Q0  | 零针基线                              | —
#  1 | R01 | ID/中继/API/Key/超级密码/锁定/隐藏 + config 预填 | patches/core/r01.sh
#  2 | R03 | is_custom_client()                    | patches/core/is-custom-client.sh
# -- 品牌 (B) --
#  3 | B01 | 各平台显示名                          | patches/brand/brand-files.sh
#  4 | B02 | logo / icon / tray                    | patches/brand/logo-assets.sh
# -- 文案 (I) --
#  5 | I01 | cn/en 文案                            | patches/i18n/ui-strings.sh
# -- Flutter (F) --
#  6 | F02 | 窗口/应用标题                         | patches/flutter/app-name.sh
#  7 | F10 | 首页 header                           | patches/flutter/home-header.sh
#  8 | F11 | Powered by                            | patches/flutter/powered-by.sh
#  9 | F12 | 关于页署名                            | patches/flutter/about-studio.sh
# -- Sciter (S) --
# 10 | S10 | 首页 UI                               | patches/sciter/home-ui.sh
# 11 | S12 | 关于页                                | patches/sciter/about-studio.sh
# 12 | S13 | 配置菜单滚动                          | patches/sciter/config-menu-css.sh
# -- 平台 (P) --
# 13 | P01 | 便携版工作目录                        | patches/platform/portable-workdir.sh
# 14 | P02 | Windows 签名                          | patches/platform/windows-signing.sh
# 15 | P03 | MSI noop                              | patches/platform/msi-noop.sh
# 16 | P04 | rust-cache 非致命                     | patches/platform/rust-cache-nonfatal.sh
# -----------------------------------------------------------------------------
#
# CUSTOM_VERIFIED_PATCH_UP_TO="R01"
# CUSTOM_VERIFIED_PATCH_UP_TO="R03"
# …

CUSTOM_VERIFIED_PATCH_UP_TO="S10"
