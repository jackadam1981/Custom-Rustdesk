# 已固化插针上限（CI 与队列构建共用）
#
# 规则：验证一项、改一项。空字符串 = 原版上游，不应用任何插针。
# 顺序见 .github/workflows/scripts/patches/manifest.sh
#
# 示例进度：
#   CUSTOM_VERIFIED_PATCH_UP_TO=""      # 基线：队列 + 原版编译
#   CUSTOM_VERIFIED_PATCH_UP_TO="R01"   # + 服务器默认 (common.rs)
#   CUSTOM_VERIFIED_PATCH_UP_TO="R02"   # + hbb_common config
#   … 直至 P04
#
# Issue 字段 patch_up_to 可临时覆盖本值（仅调试用，勿用于生产固化）。

CUSTOM_VERIFIED_PATCH_UP_TO=""
