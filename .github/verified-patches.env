# =============================================================================
# CI 插针 rollout 开关（队列构建读取本文件；patch-lab 验收通过后再改）
# =============================================================================
#
# 用法：只改最后一行 CUSTOM_VERIFIED_PATCH_UP_TO 的值。
#   ""     = Q0 零针（原版上游，不改源码）
#   "R01"  = 打到 R01（含 R01 及之前全部）
#   "P04"  = 17 针全开
#
# 顺序与 manifest.sh 一致；逐项验证、逐项 bump，勿跳号。
# Issue 字段 patch_up_to 可单次覆盖（仅 CI 调试，勿代替本文件做固化）。
#
# 本地先试：scripts/patch-lab/run.sh --profile baixin --patch-up-to R01
# 详表：downloads/Q0/patch-manifest.md
#
# -----------------------------------------------------------------------------
# 序 | ID  | 中文说明                              | 脚本模块
# -----------------------------------------------------------------------------
#  0 | Q0  | 零针基线（原版编译）                  | （不调用插针）
# -- 核心 / 服务器 (R) --
#  1 | R01 | common.rs 服务器/密钥/锁网默认        | patches/core/common-rs.sh
#  2 | R02 | hbb_common config 层默认              | patches/core/hbb-common.sh
#  3 | R03 | is_custom_client() 返回 true          | patches/core/is-custom-client.sh
# -- 品牌 (B) --
#  4 | B01 | 各平台显示名                          | patches/brand/brand-files.sh
#  5 | B02 | logo / icon / tray 图标资源           | patches/brand/logo-assets.sh
# -- 文案 (I) --
#  6 | I01 | cn/en powered_by、工作室文案          | patches/i18n/ui-strings.sh
# -- Flutter UI (F) --
#  7 | F02 | 窗口/应用标题                         | patches/flutter/app-name.sh
#  8 | F10 | 首页 banner + 名称 + slogan           | patches/flutter/home-header.sh
#  9 | F11 | 连接页 Powered by                     | patches/flutter/powered-by.sh
# 10 | F12 | 关于页工作室署名                      | patches/flutter/about-studio.sh
# -- Sciter UI (S) --
# 11 | S10 | 首页 logo/名称/slogan                 | patches/sciter/home-ui.sh
# 12 | S12 | 关于页工作室署名                      | patches/sciter/about-studio.sh
# 13 | S13 | 配置菜单单列 + 滚动                   | patches/sciter/config-menu-css.sh
# -- 平台 / CI (P) --
# 14 | P01 | 便携版工作目录                        | patches/platform/portable-workdir.sh
# 15 | P02 | Windows 测试证书签名                  | patches/platform/windows-signing.sh
# 16 | P03 | MSI 保持 RustDesk 安装名              | patches/platform/msi-noop.sh
# 17 | P04 | rust-cache 失败不阻断                 | patches/platform/rust-cache-nonfatal.sh
# -----------------------------------------------------------------------------
#
# 开实验示例（取消注释其中一行，并注释掉当前生效行）：
# CUSTOM_VERIFIED_PATCH_UP_TO=""      # Q0 零针
# CUSTOM_VERIFIED_PATCH_UP_TO="R01"
# CUSTOM_VERIFIED_PATCH_UP_TO="R02"
# CUSTOM_VERIFIED_PATCH_UP_TO="R03"
# CUSTOM_VERIFIED_PATCH_UP_TO="B01"
# CUSTOM_VERIFIED_PATCH_UP_TO="B02"
# CUSTOM_VERIFIED_PATCH_UP_TO="I01"
# CUSTOM_VERIFIED_PATCH_UP_TO="F02"
# CUSTOM_VERIFIED_PATCH_UP_TO="F10"
# CUSTOM_VERIFIED_PATCH_UP_TO="F11"
# CUSTOM_VERIFIED_PATCH_UP_TO="F12"
# CUSTOM_VERIFIED_PATCH_UP_TO="S10"
# CUSTOM_VERIFIED_PATCH_UP_TO="S12"
# CUSTOM_VERIFIED_PATCH_UP_TO="S13"
# CUSTOM_VERIFIED_PATCH_UP_TO="P01"
# CUSTOM_VERIFIED_PATCH_UP_TO="P02"
# CUSTOM_VERIFIED_PATCH_UP_TO="P03"
# CUSTOM_VERIFIED_PATCH_UP_TO="P04"

CUSTOM_VERIFIED_PATCH_UP_TO=""
